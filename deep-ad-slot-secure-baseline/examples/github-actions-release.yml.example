# Example GitHub Actions pipeline for Deep Ad Slot
# Copy to .github/workflows/release.yml in an implementation increment.
# Stages: pin → license/secret scan → SAST/tests → build → SBOM/VEX →
# isolated sign/tag → policy checks → promote.
#
# This file is an example. Tool versions are placeholders; pin them in the
# real workflow. Do not store live signing material here.

name: deep-ad-slot-release

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
  release:
    types: [published]

permissions:
  contents: read
  id-token: write   # Sigstore / OIDC; not a product GitHub PAT

env:
  PIP_INDEX_URL: https://pypi.org/simple
  PYTHON_VERSION: "3.12"

jobs:
  pin-scan-test-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Require lockfile on release tags
        if: startsWith(github.ref, 'refs/tags/')
        run: |
          test -f requirements.lock || { echo "requirements.lock missing"; exit 1; }
          grep -Eq '>=|~=' requirements.lock && { echo "floating pin in lockfile"; exit 1; } || true

      - name: Install from lockfile when present
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.lock ]; then
            pip install --require-hashes -r requirements.lock || pip install -r requirements.lock
          else
            pip install -e ".[dev]" || pip install -e .
          fi
          pip install build pytest ruff bandit pip-audit

      - name: License and secret scan
        run: |
          pip-audit || true
          ruff check src
          # Replace with gitleaks/trufflehog in implementation.
          ! git grep -E 'ghp_[A-Za-z0-9]{20,}' -- ':!.env.example' ':!deep-ad-slot-secure-baseline/**'

      - name: SAST
        run: bandit -r src/deep_ad_slot -ll

      - name: Unit and CLI tests
        run: |
          if [ -d tests ]; then pytest -q tests; else echo "tests/ missing — OI-03"; fi

      - name: Build wheel
        run: python -m build

      - name: Upload dist
        uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/

  sbom-vex:
    needs: pin-scan-test-build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
      - name: Generate SPDX SBOM (placeholder)
        run: |
          mkdir -p evidence
          echo '{"note":"replace with SPDX 3 generator; enforce conf/sbom-policy.yml"}' > evidence/sbom.spdx.json
          echo '{"note":"replace with VEX from OSV"}' > evidence/vex.json
      - uses: actions/upload-artifact@v4
        with:
          name: sbom
          path: evidence/

  sign-promote:
    if: startsWith(github.ref, 'refs/tags/')
    needs: [pin-scan-test-build, sbom-vex]
    runs-on: ubuntu-latest
    environment: prod
    permissions:
      contents: write
      id-token: write
    steps:
      - uses: actions/download-artifact@v4
      - name: Isolated sign (placeholder)
        run: |
          echo "Sign wheel + sbom.spdx.json with Sigstore or org PKCS#11."
          echo "Do not use the product GITHUB_TOKEN (repo PAT) for this step."
      - name: Attach to GitHub Release
        run: echo "Upload wheel, lockfile, sbom.spdx.json, vex.json, hashes.sha256"
